# Copy this file to .env and fill in real values. Never commit .env.

# Required for the Q&A engine (qa/ask.py, qa/webapp.py)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the Claude model used for answering questions.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: override default paths / behavior
IR_KB_DOCS_DIR=documents
IR_KB_DATA_DIR=data
