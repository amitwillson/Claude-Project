# Copy this file to .env and fill in real values. Never commit .env.

# Required for the Q&A engine (qa/ask.py, qa/webapp.py)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the Claude model used for answering questions.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: override default paths / behavior
IR_KB_DOCS_DIR=documents
IR_KB_DATA_DIR=data

# Optional: if set, qa/dashboard.py requires this password before showing
# anything (including before connecting to the database). Set this before
# exposing the dashboard via a tunnel (ngrok, etc.) to a link you're sharing
# -- without it, anyone with the link can ask unlimited questions billed to
# your ANTHROPIC_API_KEY. Leave unset for local-only use.
DASHBOARD_PASSWORD=
